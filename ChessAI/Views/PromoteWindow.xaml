<Window x:Class="ChessAI.Views.PromoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessAI.Views"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        Title="Promote" Height="250" Width="500">
    <DockPanel>
        <Label Content="Valitse nappula" FontSize="28" HorizontalAlignment="Center" DockPanel.Dock="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
            <Button x:Name="ChooseQueen" Width="120" Click="ChoosePiece">
                <StackPanel>
                    <Grid>
                        <Image x:Name="imgQueenW" Source="/Graphics/white_queen.png" Width="50" Height="50"/>
                        <Image x:Name="imgQueenB" Source="/Graphics/black_queen.png" Width="50" Height="50" Visibility="Hidden"/>
                    </Grid>
                    <Label Content="Kuningatar" HorizontalAlignment="Center" FontSize="20"/>
                </StackPanel>
            </Button>
            <Separator Width="10"/>
            <Button x:Name="ChooseKnight" Width="120" Click="ChoosePiece">
                <StackPanel>
                    <Grid>
                        <Image x:Name="imgKnightW" Source="/Graphics/white_knight.png" Width="50" Height="50"/>
                        <Image x:Name="imgKnightB" Source="/Graphics/black_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                    </Grid>
                    <Label Content="Ratsu" HorizontalAlignment="Center" FontSize="20"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
