<Window x:Class="ChessAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessAI"
        mc:Ignorable="d"
        Title="Shakkiprofessori"
        Height="750" Width="750">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Uusi peli" Click="NewGame_Click"/>
                <Button Content="Tallenna peli" Click="SaveGame_Click"/>
                <Button Content="Lataa peli" Click="LoadGame_Click"/>
                <Button Content="Vaikeustaso" Click="Difficulty_Click"/>
                <Button Content="Asetukset" Click="Settings_Click"/>
            </ToolBar>
        </ToolBarTray>
        <TextBlock x:Name="txbMoves" DockPanel.Dock="Right">
            <Label Content="Siirrot näkyvät tässä"/>
        </TextBlock>
        <Canvas>
            <Label Content="Tähän tulee lauta" Canvas.Left="267" Canvas.Top="217"/>
        </Canvas>
    </DockPanel>
</Window>
