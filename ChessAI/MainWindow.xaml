<Window x:Class="ChessAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessAI"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        ContentRendered="Window_ContentRendered"
        Title="Shakkiprofessori"
        Height="600"
        SizeToContent="Width"
        >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Width="750">
                <Button Content="Uusi peli" Click="NewGame_Click"/>
                <Button Content="Tallenna peli" Click="SaveGame_Click"/>
                <Button Content="Lataa peli" Click="LoadGame_Click"/>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Vaikeustaso" Click="Difficulty_Click"/>
                <Button Content="Asetukset" Click="Settings_Click"/>
            </ToolBar>
        </ToolBarTray>
        <TextBlock x:Name="txbMoves" DockPanel.Dock="Right" Margin="10">
            <Label Content="Siirrot näkyvät tässä"/>
        </TextBlock>
        <DockPanel>
            <Canvas DockPanel.Dock="Left" Margin="5" Width="100" Height="400" VerticalAlignment="Center">
                <Label Content="Mustan" Width="80" Canvas.Left="20" Canvas.Top="190"/>
                <Label Content="syödyt" Width="80" Canvas.Left="20" Canvas.Top="210"/>
            </Canvas>
            <Canvas DockPanel.Dock="Right" Margin="5" Width="100" Height="400" VerticalAlignment="Center">
                <Label Content="Valkoisen" Width="80" Canvas.Left="20" Canvas.Top="190"/>
                <Label Content="syödyt" Width="80" Canvas.Left="20" Canvas.Top="210"/>
            </Canvas>
            <Border Margin="5" BorderBrush="Black" BorderThickness="5" VerticalAlignment="Center">
                <Grid>
                    <Canvas x:Name="cnvBoard" IsHitTestVisible="False" Width="400" Height="400">
                        <Label Content="Lauta" Canvas.Left="180" Canvas.Top="180"/>
                    </Canvas>
                    <Canvas x:Name="cnvPieces" Background="Transparent" Width="400" Height="400">
                    </Canvas>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
