<Window x:Class="ChessAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessAI"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        ContentRendered="Window_ContentRendered"
        Title="Shakkiprofessori"
        SizeToContent="WidthAndHeight" Closing="Window_Closing"
        >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Mieti"
                        BorderThickness="2"
                        Click="Think_Click"
                        />
                <Border BorderBrush="DarkGray" BorderThickness="1" Padding="1,2,1,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Vuoro" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbActivePlayer" Width="70" Margin="1,0,0,0" SelectionChanged="cmbActivePlayer_SelectionChanged"
                                VerticalAlignment="Center" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Left">
                            <ComboBoxItem Content="Valkea" x:Name="cmbItemWhite" Selector.IsSelected="True"/>
                            <ComboBoxItem Content="Musta" x:Name="cmbItemBlack"/>
                            <ComboBoxItem Content="vapaa" x:Name="cmbItemNeither"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Padding="1,2,1,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Hakusyvyys" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbDepth" Width="40" Margin="1,0,0,0" SelectionChanged="cmbDepth_SelectionChanged"
                                  VerticalAlignment="Center" VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Left">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2" Selector.IsSelected="True"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Alkutila" Click="NewGame_Click"/>
                <Button Content="Tyhjennä" Click="ClearBoard_Click"/>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Tallenna peli" Click="SaveGame_Click"/>
                <Button Content="Lataa peli" Click="LoadGame_Click"/>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Asetukset" Click="Settings_Click"/>
            </ToolBar>
        </ToolBarTray>
        <Grid DockPanel.Dock="Right" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Valkea" FontWeight="Bold" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txbMovesWhite" Grid.Row="1" Grid.Column="0" Width="80"/>
            <Label Content="Musta" FontWeight="Bold" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txbMovesBlack" Grid.Row="1" Grid.Column="1" Width="80"/>
        </Grid>
        <Label x:Name="lblSelected" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="10"/>
        <DockPanel>
            <Grid DockPanel.Dock="Left" Margin="5" VerticalAlignment="Center">
                <Canvas x:Name="cnvWhiteBoard" Width="100" Height="400"
                        IsHitTestVisible="False"/>
                <Canvas x:Name="cnvWhitePieces" Width="100" Height="400"
                        Background="Transparent"
                        MouseLeftButtonDown="cnvWhitePieces_MouseLeftButtonDown"/>
            </Grid>
            <Grid DockPanel.Dock="Right" Margin="5" VerticalAlignment="Center">
                <Canvas x:Name="cnvBlackBoard" Width="100" Height="400"
                        IsHitTestVisible="False"/>
                <Canvas x:Name="cnvBlackPieces" Width="100" Height="400"
                        Background="Transparent"
                    MouseLeftButtonDown="cnvBlackPieces_MouseLeftButtonDown"/>
            </Grid>
            <Border Style="{StaticResource BoardOuterBorder}" Margin="5" VerticalAlignment="Center">
            <Border Style="{StaticResource BoardInnerBorder}">
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Margin" Value="4"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="A" FontWeight="Bold" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="B" FontWeight="Bold" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="C" FontWeight="Bold" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="D" FontWeight="Bold" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="E" FontWeight="Bold" Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="F" FontWeight="Bold" Grid.Row="0" Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="G" FontWeight="Bold" Grid.Row="0" Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="H" FontWeight="Bold" Grid.Row="0" Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="A" FontWeight="Bold" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="B" FontWeight="Bold" Grid.Row="9" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="C" FontWeight="Bold" Grid.Row="9" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="D" FontWeight="Bold" Grid.Row="9" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="E" FontWeight="Bold" Grid.Row="9" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="F" FontWeight="Bold" Grid.Row="9" Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="G" FontWeight="Bold" Grid.Row="9" Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="H" FontWeight="Bold" Grid.Row="9" Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="8" FontWeight="Bold" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="7" FontWeight="Bold" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="6" FontWeight="Bold" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="5" FontWeight="Bold" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="4" FontWeight="Bold" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="3" FontWeight="Bold" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="2" FontWeight="Bold" Grid.Row="7" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="1" FontWeight="Bold" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="8" FontWeight="Bold" Grid.Row="1" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="7" FontWeight="Bold" Grid.Row="2" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="6" FontWeight="Bold" Grid.Row="3" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="5" FontWeight="Bold" Grid.Row="4" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="4" FontWeight="Bold" Grid.Row="5" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="3" FontWeight="Bold" Grid.Row="6" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="2" FontWeight="Bold" Grid.Row="7" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="1" FontWeight="Bold" Grid.Row="8" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Canvas x:Name="cnvBoard" IsHitTestVisible="False" Width="400" Height="400"
                            Grid.Row="1" Grid.RowSpan="8" Grid.Column="1" Grid.ColumnSpan="8"
                            >
                        <Label Content="Lauta" Canvas.Left="180" Canvas.Top="180"/>
                    </Canvas>
                    <Canvas x:Name="cnvPieces" Background="Transparent" Width="400" Height="400"
                            Grid.Row="1" Grid.RowSpan="8" Grid.Column="1" Grid.ColumnSpan="8"
                            MouseLeftButtonDown="cnvPieces_MouseLeftButtonDown">
                        <!-- nappulat asetetaan oikeille paikoille ohjelmallisesti -->
                        <Image x:Name="whitePawn1" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn2" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn3" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn4" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn5" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn6" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn7" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn8" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteBishop1" Source="Graphics/white_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteBishop2" Source="Graphics/white_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteKnight1" Source="Graphics/white_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteKnight2" Source="Graphics/white_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteQueen" Source="Graphics/white_queen.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteKing" Source="Graphics/white_king.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteRook1" Source="Graphics/white_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteRook2" Source="Graphics/white_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn1" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn2" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn3" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn4" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn5" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn6" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn7" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn8" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackBishop1" Source="Graphics/black_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackBishop2" Source="Graphics/black_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackKnight1" Source="Graphics/black_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackKnight2" Source="Graphics/black_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackQueen" Source="Graphics/black_queen.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackKing" Source="Graphics/black_king.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackRook1" Source="Graphics/black_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackRook2" Source="Graphics/black_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                    </Canvas>
                </Grid>
            </Border>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
