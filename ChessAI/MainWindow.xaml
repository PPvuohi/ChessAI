<Window x:Class="ChessAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessAI"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        Title="Shakkiprofessori"
        Height="600" Width="750">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Width="750">
                <Button Content="Uusi peli" Click="NewGame_Click"/>
                <Button Content="Tallenna peli" Click="SaveGame_Click"/>
                <Button Content="Lataa peli" Click="LoadGame_Click"/>
                <Button Content="Vaikeustaso" Click="Difficulty_Click"/>
                <Button Content="Asetukset" Click="Settings_Click"/>
            </ToolBar>
        </ToolBarTray>
        <TextBlock x:Name="txbMoves" DockPanel.Dock="Right" Margin="10">
            <Label Content="Siirrot näkyvät tässä"/>
        </TextBlock>
        <Canvas Margin="10" Width="500" Height="500">
            <Label Content="Tähän tulee lauta" Canvas.Left="200" Canvas.Top="224"/>
        </Canvas>
    </DockPanel>
</Window>
