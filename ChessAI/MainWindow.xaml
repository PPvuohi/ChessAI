<Window x:Class="ChessAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessAI"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        ContentRendered="Window_ContentRendered"
        Title="Shakkiprofessori"
        Height="600"
        SizeToContent="Width"
        >
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Width="750">
                <Button Content="Mieti"
                        BorderThickness="2"
                        Click="Think_Click"
                        />
                <Border BorderBrush="DarkGray" BorderThickness="1" Padding="1,2,1,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Vuoro" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbActivePlayer" Width="70" Margin="1,0,0,0" SelectionChanged="cmbActivePlayer_SelectionChanged"
                                VerticalAlignment="Center" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Left">
                            <ComboBoxItem Content="Valkea" Selector.IsSelected="True"/>
                            <ComboBoxItem Content="Musta"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Padding="1,2,1,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Hakusyvyys" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbDepth" Width="40" Margin="1,0,0,0" SelectionChanged="cmbDepth_SelectionChanged"
                                  VerticalAlignment="Center" VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Left">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2" Selector.IsSelected="True"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Alkutila" Click="NewGame_Click"/>
                <Button Content="Tyhjennä" Click="ClearBoard_Click"/>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Tallenna peli" Click="SaveGame_Click"/>
                <Button Content="Lataa peli" Click="LoadGame_Click"/>
                <Separator Margin="10,0,10,0"/>
                <Button Content="Asetukset" Click="Settings_Click"/>
            </ToolBar>
        </ToolBarTray>
        <TextBlock x:Name="txbMoves" DockPanel.Dock="Right" Margin="10">
            <Label Content="Siirrot näkyvät tässä"/>
        </TextBlock>
        <DockPanel>
            <Canvas x:Name="cnvWhitePieces" DockPanel.Dock="Left" Margin="5" Width="100" Height="400" VerticalAlignment="Center"/>
            <Canvas x:Name="cnvBlackPieces" DockPanel.Dock="Right" Margin="5" Width="100" Height="400" VerticalAlignment="Center"/>
                <Border Margin="5" BorderBrush="Black" BorderThickness="5" VerticalAlignment="Center">
                <Grid>
                    <Canvas x:Name="cnvBoard" IsHitTestVisible="False" Width="400" Height="400">
                        <Label Content="Lauta" Canvas.Left="180" Canvas.Top="180"/>
                    </Canvas>
                    <Canvas x:Name="cnvPieces" Background="Transparent" Width="400" Height="400">
                        <!-- nappulat asetetaan oikeille paikoille ohjelmallisesti -->
                        <Image x:Name="whitePawn1" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn2" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn3" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn4" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn5" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn6" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn7" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whitePawn8" Source="Graphics/white_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteBishop1" Source="Graphics/white_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteBishop2" Source="Graphics/white_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteKnight1" Source="Graphics/white_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteKnight2" Source="Graphics/white_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteQueen" Source="Graphics/white_queen.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteKing" Source="Graphics/white_king.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteRook1" Source="Graphics/white_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="whiteRook2" Source="Graphics/white_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn1" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn2" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn3" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn4" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn5" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn6" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn7" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackPawn8" Source="Graphics/black_pawn.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackBishop1" Source="Graphics/black_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackBishop2" Source="Graphics/black_bishop.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackKnight1" Source="Graphics/black_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackKnight2" Source="Graphics/black_knight.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackQueen" Source="Graphics/black_queen.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackKing" Source="Graphics/black_king.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackRook1" Source="Graphics/black_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                        <Image x:Name="blackRook2" Source="Graphics/black_rook.png" Width="50" Height="50" Visibility="Hidden"/>
                    </Canvas>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
